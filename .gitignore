# Dependencies
node_modules/

# Rust build artifacts
target/
*/target/
# Cargo.lock IS committed: odk ships a binary crate (odk-cli), so the lockfile
# must be version-controlled for reproducible builds (a fresh checkout without
# it re-resolves to incompatible toolchain/native-build deps)

# TypeScript build output
dist/
*/dist/

# Bun lock files (keep root bun.lock for reproducibility)
odk-ts/bun.lock

# TypeSpec generated artifacts
generated/
generated-*/
tsp-out/
tspgen/out/

# Test/scratch files
schema-test*.json

# IDE
.idea/
.vscode/
*.swp
*.swo

# Agent / tooling local state
.claude/
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# Temp files
*.tmp
*.temp
.odk-temp/

# Docs
docs/

# Env files
.env.*
.env.local.template

# Python
__pycache__/
*.pyc

# Local config
weaver.yaml

# Dependency management (belong in individual repos)
renovate.json
