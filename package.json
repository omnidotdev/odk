{
  "name": "@omnidotdev/odk-typespec",
  "version": "0.1.3",
  "type": "module",
  "private": true,
  "workspaces": [
    "odk-ts"
  ],
  "scripts": {
    "compile": "tsp compile .",
    "compile:watch": "tsp compile . --watch",
    "generate:graphql": "bun openapi-generator-cli generate -i generated/schema/openapi3/openapi.yaml -g graphql-schema -o ./graphql-schema",
    "clean": "rm -rf ./generated",
    "prepare": "husky",
    "knip": "knip-bun",
    "check": "biome check",
    "lint": "biome lint",
    "changeset": "changeset",
    "version": "changeset version && bun run sync:versions",
    "sync:versions": "bun run scripts/sync-versions.ts",
    "release": "bun run --cwd odk-ts build && changeset publish"
  },
  "dependencies": {
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@typespec/compiler": "^1.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^3.0.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "typescript": "^5.9.3"
  }
}
