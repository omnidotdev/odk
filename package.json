{
  "name": "@omnidotdev/odk",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "compile": "tsp compile .",
    "compile:watch": "tsp compile . --watch",
    "generate:graphql": "bun openapi-generator-cli generate -i generated/schema/openapi3/openapi.yaml -g graphql-schema -o ./graphql-schema",
    "clean": "rm -rf ./generated",
    "prepare": "husky",
    "knip": "knip-bun",
    "check": "biome check",
    "lint": "biome lint"
  },
  "dependencies": {
    "@openapitools/openapi-generator-cli": "^2.25.0",
    "@typespec/compiler": "^1.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@types/node": "^24.10.1",
    "husky": "^9.1.7",
    "knip": "^5.86.0",
    "typescript": "^5.9.3"
  }
}
